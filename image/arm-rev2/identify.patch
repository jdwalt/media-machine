+_GENERIC_DISC_TITLES = {
+    "",
+    "none",
+    "notidentified",
+    "dvdvideo",
+    "videodvd",
+    "dvd",
+    "video",
+    "dvdrom",
+    "bdrom",
+    "bdmv",
+    "bluray",
+    "nolabel",
+    "unknown",
+    "disc",
+    "disk",
+}
+
+
+def _is_generic_disc_title(title):
+    """Return True when a title is only a generic media label."""
+    if title is None:
+        return True
+
+    normalized = re.sub(
+        r"[^a-z0-9]+",
+        "",
+        str(title).strip().lower(),
+    )
+    return normalized in _GENERIC_DISC_TITLES
+

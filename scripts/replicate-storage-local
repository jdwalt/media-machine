#!/usr/bin/env bash
set -Eeuo pipefail

SOURCE='/srv/storage/'
DESTINATION='/srv/backup-local/'
VERSION_ROOT='/srv/backup-local/.versions'
TIMESTAMP="$(date -u +'%Y-%m-%dT%H-%M-%SZ')"
VERSION_DIR="$VERSION_ROOT/$TIMESTAMP"
LOCKFILE='/run/lock/storage-replication.lock'

exec 9>"$LOCKFILE"

if ! flock -n 9; then
    printf 'Replication is already running.\n' >&2
    exit 75
fi

if ! mountpoint -q /srv/storage; then
    printf 'ERROR: /srv/storage is not mounted.\n' >&2
    exit 1
fi

if ! mountpoint -q /srv/backup-local; then
    printf 'ERROR: /srv/backup-local is not mounted.\n' >&2
    exit 1
fi

mkdir -p "$VERSION_DIR"

printf 'Replication started: %s\n' "$TIMESTAMP"
printf 'Source: %s\n' "$SOURCE"
printf 'Destination: %s\n' "$DESTINATION"
printf 'Changed-file versions: %s\n' "$VERSION_DIR"

rsync \
    --archive \
    --hard-links \
    --acls \
    --xattrs \
    --numeric-ids \
    --backup \
    --backup-dir="$VERSION_DIR" \
    --exclude='/.versions/' \
    --exclude='/.rsync-partial/' \
    --partial \
    --partial-dir='.rsync-partial' \
    --human-readable \
    --stats \
    "$SOURCE" \
    "$DESTINATION"

find "$VERSION_DIR" -depth -type d -empty -delete 2>/dev/null || true

printf 'Replication completed: %s\n' "$(date -u +'%Y-%m-%dT%H-%M-%SZ')"

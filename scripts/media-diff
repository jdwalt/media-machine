#!/usr/bin/env bash

set -u

SCRIPT_VERSION="2.1.0-2026-08-17"
SNAPDIR="/var/log/media-machine/snapshots"

usage() {
    echo "Usage:"
    echo "  media-diff"
    echo "  media-diff --important"
}

extract_important() {
    local file="$1"
    awk '
    function wanted(title) {
        return title ~ /^ (DIAGNOSTIC SCRIPT INFO|CONTROLLED HARDWARE CHECK|HBA \/ CONTROLLER|HBA-ATTACHED DRIVE MAP|PHYSICAL NETWORK|NETWORK|USB TOPOLOGY \/ NEGOTIATED SPEEDS|FILESYSTEMS \/ MOUNTS|BLOCK DEVICES|SCSI \/ OPTICAL DEVICES|SMART HEALTH \/ INTEGRITY|SMART SUMMARY|DOCKER|CORE SERVICES|TEMPERATURES|DELL FAN \/ THERMAL TELEMETRY|CPU TEMPERATURES|HBA \/ SCSI BOOT EVENTS|OPTICAL MEDIA EVENTS|STORAGE ERROR CHECK|RECENT STORAGE \/ SATA \/ NVME ERRORS|REBOOT REQUIRED|FIRMWARE STATUS)$/
    }
    /^================================================================$/ {
        if ((getline title) <= 0) exit
        if ((getline border) <= 0) exit
        keep=wanted(title)
        if (keep) {
            if (printed) print ""
            print "================================================================"
            print title
            print "================================================================"
            printed=1
        }
        next
    }
    keep { print }
    ' "$file"
}

case "${1:-}" in
    "") MODE="full" ;;
    --important) MODE="important" ;;
    *) usage; exit 2 ;;
esac

mapfile -t FILES < <(find "$SNAPDIR" -maxdepth 1 -type f -name '*.txt' -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -2 | cut -d' ' -f2-)

if [ "${#FILES[@]}" -lt 2 ]; then
    echo "Need at least two snapshots in:"
    echo "  $SNAPDIR"
    exit 1
fi

BEFORE="${FILES[0]}"
AFTER="${FILES[1]}"

echo "================================================================"
if [ "$MODE" = "important" ]; then
    echo " MEDIA-MACHINE IMPORTANT DIFF"
else
    echo " MEDIA-MACHINE SNAPSHOT DIFF"
fi
echo "================================================================"
echo "media-diff version: $SCRIPT_VERSION"
echo "Before: $BEFORE"
echo "After:  $AFTER"
echo "================================================================"
echo

if [ "$MODE" = "important" ]; then
    TMPOLD="$(mktemp)"
    TMPNEW="$(mktemp)"
    trap 'rm -f "$TMPOLD" "$TMPNEW"' EXIT
    extract_important "$BEFORE" > "$TMPOLD"
    extract_important "$AFTER" > "$TMPNEW"
    diff --color=auto -u --label "BEFORE" --label "AFTER" "$TMPOLD" "$TMPNEW"
    STATUS=$?
else
    diff --color=auto -u --label "BEFORE" --label "AFTER" "$BEFORE" "$AFTER"
    STATUS=$?
fi

echo
echo "================================================================"
case "$STATUS" in
    0) echo "No differences." ;;
    1) echo "Differences shown above." ;;
    *) echo "diff encountered an error."; exit "$STATUS" ;;
esac
echo "================================================================"
exit 0

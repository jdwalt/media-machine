{
  "name": "jellyfin",
  "services": {
    "jellyfin": {
      "image": "jellyfin/jellyfin:12.0",
      "pull_policy": "never",
      "container_name": "jellyfin",
      "user": "1000:1000",
      "group_add": [
        "993"
      ],
      "ports": [
        "8096:8096/tcp",
        "7359:7359/udp"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/home/mediaadmin/jellyfin/config",
          "target": "/config"
        },
        {
          "type": "bind",
          "source": "/home/mediaadmin/jellyfin/cache",
          "target": "/cache"
        },
        {
          "type": "bind",
          "source": "/srv/media",
          "target": "/media",
          "read_only": true
        }
      ],
      "devices": [
        "/dev/dri/renderD128:/dev/dri/renderD128"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "restart": "no"
    }
  }
}
